{
  "name": "numed-monorepo",
  "private": true,
  "scripts": {
    "typecheck:numed-health": "npm run typecheck --prefix services/numed-health",
    "typecheck:reminders": "npm run typecheck --prefix services/reminders",
    "typecheck:user-auth": "npm run typecheck --prefix services/user-auth",
    "typecheck:all": "npm run typecheck:numed-health && npm run typecheck:reminders && npm run typecheck:user-auth",
    "lint:numed-health": "npm run lint --prefix services/numed-health",
    "lint:reminders": "npm run lint --prefix services/reminders",
    "lint:user-auth": "npm run lint --prefix services/user-auth",
    "lint:all": "npm run lint:numed-health && npm run lint:reminders && npm run lint:user-auth",
    "check:numed-health": "npm run check --prefix services/numed-health",
    "check:reminders": "npm run check --prefix services/reminders",
    "check:user-auth": "npm run check --prefix services/user-auth",
    "check:all": "npm run check:numed-health && npm run check:reminders && npm run check:user-auth",
    "validate:all": "npm run check:all && npm run typecheck:all",
    "start:numed-health": "npm run start:dev --prefix services/numed-health",
    "start:reminders": "npm run start:dev --prefix services/reminders",
    "start:user-auth": "npm run start:dev --prefix services/user-auth"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "~4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "~11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "~11.2.6",
    "amqplib": "~1.0.3",
    "class-transformer": "~0.5.1",
    "class-validator": "~0.15.1",
    "drizzle-orm": "~0.45.1",
    "pg": "~8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.4.6",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "~0.10.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "~8.18.0",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "~0.31.9",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}